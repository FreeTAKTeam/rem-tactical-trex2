{
  "name": "rem-zepp-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zepp OS 2.1 application for the Amazfit T-Rex 2",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "watchface:build": "node scripts/build-watchface.mjs build -t \"Amazfit T-Rex 2\"",
    "watchface:preview": "node scripts/build-watchface.mjs preview -t \"Amazfit T-Rex 2\"",
    "watchface:bridge": "node scripts/build-watchface.mjs bridge",
    "radar:assets": "node scripts/generate-radar-assets.mjs",
    "radar:preview": "node scripts/serve-radar-preview.mjs",
    "radar:render": "node scripts/render-radar-preview.mjs",
    "test": "node --test test"
  },
  "devDependencies": {
    "@zeppos/device-types": "3.0.1",
    "@zeppos/zeus-cli": "1.9.1"
  }
}
