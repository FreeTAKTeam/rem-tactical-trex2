{
  "configVersion": "v3",
  "app": {
    "appId": 1117630,
    "appName": "REM Sync",
    "appType": "app",
    "version": {
      "code": 31,
      "name": "0.1.30"
    },
    "icon": "icon.png",
    "cover": [
      "preview.png"
    ],
    "vender": "Corvo",
    "description": "Read-only REM radar and status companion for Amazfit T-Rex 2"
  },
  "permissions": [
    "device:os.ble",
    "device:os.compass"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "1.0.0",
      "target": "1.0.1",
      "minVersion": "1.0.0"
    }
  },
  "targets": {
    "trex2": {
      "module": {
        "page": {
          "pages": [
            "page/radar/index",
            "page/status/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "name": "trex2-cn",
          "deviceSource": 418
        },
        {
          "name": "trex2-global",
          "deviceSource": 419
        }
      ],
      "designWidth": 454
    }
  },
  "i18n": {
    "en-US": {
      "appName": "REM Sync"
    }
  },
  "defaultLanguage": "en-US",
  "debug": true
}
