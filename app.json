{
  "configVersion": "v3",
  "app": {
    "appId": 306967168,
    "appName": "REM Tactical",
    "appType": "watchface",
    "version": {
      "code": 21,
      "name": "1.3.3"
    },
    "icon": "icon.png",
    "cover": [
      "preview.png"
    ],
    "vender": "Corvo",
    "description": "Tactical digital watch face for Amazfit T-Rex 2"
  },
  "permissions": [
    "data:user.hd.heart_rate",
    "gps"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "2.1",
      "target": "2.1",
      "minVersion": "2.1"
    }
  },
  "targets": {
    "trex2": {
      "module": {
        "watchface": {
          "path": "watchface/trex2/index",
          "main": 1,
          "editable": 0,
          "lockscreen": 1,
          "hightCost": 1
        }
      },
      "platforms": [
        {
          "name": "trex2-cn",
          "deviceSource": 418
        },
        {
          "name": "trex2-global",
          "deviceSource": 419
        }
      ],
      "designWidth": 454
    }
  },
  "i18n": {
    "en-US": {
      "name": "REM Tactical"
    }
  },
  "defaultLanguage": "en-US",
  "debug": false
}
